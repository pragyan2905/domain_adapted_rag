# =============================================================================
# TelecomRAG Backend — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
# =============================================================================

# --- 1. LLM API Key (Required) ---
# Get a free Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# --- 2. Application Server ---
PORT=8001
HOST=0.0.0.0

# --- 3. Vector Database (Qdrant) ---
# Option A: Local Docker (Default)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Option B: Managed Qdrant Cloud (Uncomment to use)
# QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_cloud_api_key

# --- 4. Semantic Cache & Rate Limiting (Redis) ---
# Option A: Local Docker (Default)
REDIS_HOST=localhost
REDIS_PORT=6380

# Option B: Cloud Serverless Redis (e.g., Upstash / Redis Cloud)
# REDIS_URL=rediss://default:your_token@your-host.upstash.io:6379

# --- 5. Audit Logging & Analytics Database ---
# Option A: Local SQLite (Default, zero configuration needed)
SQLITE_DB_PATH=telecom_qa.db

# Option B: Cloud PostgreSQL (e.g., Neon / Supabase / AWS RDS)
# DATABASE_URL=postgresql://user:password@ep-host.region.neon.tech/neondb?sslmode=require
